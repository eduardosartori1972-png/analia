{
  "name": "analia",
  "version": "0.1.0",
  "private": true,
  "description": "AnalIA — asistente digital para adultos mayores. MVP Etapa 0: esqueleto.",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:client-bundle"
  },
  "dependencies": {
    "jsonrepair": "3.15.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vitest": "5.0.5"
  }
}
