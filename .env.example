# Ejemplo de configuración. Copiar a .env.local y completar ahí.
# .env.local está en .gitignore y NUNCA se commitea.
#
# Ninguna de estas variables puede llevar el prefijo NEXT_PUBLIC_: se leen solo
# en el servidor. El chequeo `pnpm check:client-bundle` falla si una aparece en
# el bundle del navegador.

# --- Proveedor primario -----------------------------------------------------
# fake (sin costo, sin red) | deepseek | openai
ANALYZE_PROVIDER=fake

# Clave del proveedor primario.
# ANALYZE_API_KEY=
# Modelo exacto. Para DeepSeek, el nombre que devuelve su panel de modelos.
# ANALYZE_MODEL=deepseek-flash
# Espacio para la respuesta. 4096 por defecto: si el modelo arranca con una frase
# de más, igual llega a escribir el JSON.
# ANALYZE_MAX_TOKENS=4096
# Opcional, para pruebas o proxies. Por defecto cada proveedor usa su URL oficial.
# ANALYZE_BASE_URL=https://api.deepseek.com

# --- Proveedor de respaldo --------------------------------------------------
# Si el primario falla o da timeout, la cadena intenta este antes de mostrar el error.
# none | deepseek | openai
ANALYZE_FALLBACK_PROVIDER=none
# ANALYZE_FALLBACK_API_KEY=
# ANALYZE_FALLBACK_MODEL=
# ANALYZE_FALLBACK_BASE_URL=

# --- Proveedor simulado -----------------------------------------------------
# Solo con ANALYZE_PROVIDER=fake. Escenarios para recorrer cada estado de la UI:
# auto | legitimo | sospechoso | ambiguo | estafa | inyectado | error
# ANALYZE_FAKE_SCENARIO=auto

# --- Límites ----------------------------------------------------------------
# Consultas por IP cada 10 minutos.
# ANALYZE_RATE_LIMIT=30
# Techo mensual. Si se conoce el costo por consulta, el presupuesto manda.
# ANALYZE_MONTHLY_LIMIT=100
# ANALYZE_MONTHLY_BUDGET_USD=3
# ANALYZE_COST_PER_CALL_USD=

# Opcional: desactiva la telemetría de Next en builds locales.
# NEXT_TELEMETRY_DISABLED=1
