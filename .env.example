# Etapas 0–2: no hace falta ninguna clave.
# El proveedor de visión arranca simulado (fake) hasta que se elija el real.
# Ver docs/DECISIONS.md — ADR-004.
ANALYZE_PROVIDER=fake

# Etapa 3 (pendiente de decisión): clave del proveedor de visión.
# NUNCA con prefijo NEXT_PUBLIC_: estas variables solo se leen en el servidor.
# ANALYZE_API_KEY=
# ANALYZE_MODEL=

# Opcional: desactiva la telemetría de Next en builds locales.
# NEXT_TELEMETRY_DISABLED=1
